# ---------- Database ----------
# Include the database name in the path, e.g. /cherrymate
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/cherrymate?retryWrites=true&w=majority"
# Optional: DNS servers for the mongodb+srv lookup. If your network breaks SRV lookups (EBADRESP —
# common on phone hotspots) the app already falls back to 8.8.8.8/1.1.1.1 automatically.
# MONGODB_DNS_SERVERS="8.8.8.8,1.1.1.1"

# ---------- Google sign-in (plain OAuth 2.0, no auth library) ----------
# Signs our session cookie. At least 32 chars. Generate: openssl rand -base64 32
AUTH_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional: public URL used to build the OAuth redirect URI (set it when using a tunnel or custom domain).
# Redirect URI registered in Google must be: <APP_URL>/api/auth/google/callback
# APP_URL="http://localhost:3000"

# ---------- Pusher Channels ----------
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER="ap2"
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="ap2"

# ---------- Cloudinary ----------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---------- Web Push (generate with: npm run vapid) ----------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:hello@cherrymate.app"

# ---------- Maps ----------
# Free, no key: https://tiles.openfreemap.org/styles/positron
NEXT_PUBLIC_MAP_STYLE_URL="https://tiles.openfreemap.org/styles/positron"
# Optional dark style (falls back to OpenFreeMap dark)
NEXT_PUBLIC_MAP_STYLE_URL_DARK="https://tiles.openfreemap.org/styles/dark"
# Optional — only if you use MapTiler styles instead (put {key} in the style URL)
MAPTILER_KEY=""
