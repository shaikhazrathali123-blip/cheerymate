{
  "name": "cherrymate",
  "version": "1.0.0",
  "private": true,
  "description": "Cherrymate — find someone you can comfortably live with. Roommate matching PWA for India.",
  "scripts": {
    "predev": "node -e \"const fs=require('fs');for(const f of fs.readdirSync('public'))if(/^(sw\\.js|swe-worker-.*\\.js|workbox-.*\\.js)(\\.map)?$/.test(f))fs.rmSync('public/'+f)\"",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "seed": "tsx scripts/seed.ts",
    "indexes": "tsx scripts/ensure-indexes.ts",
    "icons": "node scripts/generate-icons.mjs",
    "vapid": "web-push generate-vapid-keys"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.0.1",
    "@radix-ui/react-slot": "^1.1.2",
    "@serwist/next": "^9.0.11",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.5.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.4.7",
    "jose": "^6.2.17",
    "lucide-react": "^0.475.0",
    "maplibre-gl": "^5.1.0",
    "mongoose": "^8.10.1",
    "next": "^15.3.0",
    "pusher": "^5.2.0",
    "pusher-js": "^8.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "react-map-gl": "^8.0.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.1",
    "tailwind-merge": "^3.0.1",
    "vaul": "^1.1.2",
    "web-push": "^3.6.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.6",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/web-push": "^3.6.4",
    "dotenv": "^16.4.7",
    "serwist": "^9.0.11",
    "sharp": "^0.33.5",
